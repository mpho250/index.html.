
document.addEventListener("DOMContentLoaded", function () {
    const form = document.getElementById("recommendation-form");
    const input = document.getElementById("recommendation");
    const list = document.getElementById("recommendation-list");

    form.addEventListener("submit", function (event) {
        event.preventDefault();

        const recommendationText = input.value.trim();

        if (recommendationText !== "") {
            const newRecommendation = document.createElement("li");

            newRecommendation.textContent = recommendationText;

            list.appendChild(newRecommendation);

            input.value = "";

            alert("Thank you for your recommendation!");
        }
    });
});
